<!DOCTYPE html>
<html lang="en">
<head>
    <title>Lecture Notes AI</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #fafafa;
            color: #1a1a1a;
            line-height: 1.5;
        }

        .topbar {
            padding: 20px 40px;
            background: #f7f5f0;
            border-bottom: 1px solid #e8e4da;
        }

        .logo {
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 1px;
            color: #2b2b2b;
            text-transform: uppercase;
        }

        .main {
            max-width: 560px;
            margin: 0 auto;
            padding: 80px 24px;
        }

        .header {
            margin-bottom: 32px;
        }
        .header h1 {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #1a1a1a;
        }
        .header p {
            font-size: 14px;
            color: #777;
        }

        .card {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 10px;
            padding: 24px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #444;
            margin-bottom: 8px;
        }

        input[type="text"] {
            width: 100%;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #ddd;
            font-size: 14px;
            font-family: inherit;
            color: #1a1a1a;
            outline: none;
        }
        input[type="text"]:focus {
            border-color: #999;
        }
        input[type="text"]::placeholder {
            color: #aaa;
        }

        button[type="submit"] {
            margin-top: 16px;
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 6px;
            background: #2d2d2d;
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            font-family: inherit;
        }
        button[type="submit"]:hover {
            background: #1a1a1a;
        }

        #output {
            margin-top: 16px;
            font-size: 13px;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="logo">Lecture Notes AI</div>
    </div>

    <div class="main">
        <div class="header">
            <h1>Generate notes from a lecture</h1>
            <p>Paste a YouTube video URL to get AI-generated study notes.</p>
        </div>

        <div class="card">
            <form action="/youtube" method="POST">
                <label for="url">YouTube URL</label>
                <input type="text" id="url" name="url" placeholder="https://www.youtube.com/watch?v=..." required>
                <button type="submit">Generate Notes</button>
            </form>
            <p id="output"></p>
        </div>
    </div>
</body>
</html>