<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your notes | YT Notes</title>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Figtree', system-ui, sans-serif; background: #f4f6fb; color: #1a1f36; }
    a { color: inherit; text-decoration: none; }

    .topbar { display: flex; justify-content: space-between; align-items: center; padding: 18px 40px; }
    .brand { font-weight: 700; font-size: 1.25rem; color: #1c2557; }
    .topbar nav a { margin-left: 18px; font-weight: 600; color: #1c2557; }

    .layout { display: grid; grid-template-columns: 280px 1fr; gap: 28px; max-width: 1100px; margin: 0 auto; padding: 8px 40px 60px; align-items: start; }

    .history { background: #fff; border: 1.5px solid #d3d9ea; border-radius: 14px; padding: 16px; }
    .history h2 { font-size: 1.05rem; color: #1c2557; margin-bottom: 10px; }
    .history a { display: block; padding: 10px; border-radius: 8px; border-left: 3px solid transparent; }
    .history a:hover, .history a.active { background: #eef1fa; }
    .history a.active { border-left-color: #1c2557; }
    .history b { display: block; font-size: .95rem; }
    .history small { color: #5d6480; }

    h1 { font-size: 2rem; color: #1c2557; margin-bottom: 6px; }
    .meta { color: #5d6480; margin-bottom: 20px; }
    .meta a { color: #1c2557; font-weight: 600; text-decoration: underline; }
    .notes { background: #fff; border: 1.5px solid #d3d9ea; border-radius: 14px; padding: 32px; line-height: 1.7; overflow-wrap: anywhere; }
    .notes h1, .notes h2, .notes h3 { color: #1c2557; margin: 1em 0 .4em; }
    .notes h1:first-child, .notes h2:first-child { margin-top: 0; }
    .notes ul, .notes ol { margin-left: 1.3em; }
    .empty { background: #fff; border: 1.5px dashed #d3d9ea; border-radius: 14px; padding: 48px 24px; text-align: center; color: #5d6480; }
    .empty a { display: inline-block; margin-top: 14px; background: #1c2557; color: #fff; padding: 11px 22px; border-radius: 8px; font-weight: 600; }

    @media (max-width: 800px) {
      .layout { grid-template-columns: 1fr; padding: 8px 20px 40px; }
      .topbar { padding: 16px 20px; }
    }
  </style>
</head>
<body>

  <header class="topbar">
    <a class="brand" href="/">YT Notes</a>
    <nav>
      <a href="/">New notes</a>
      <a href="/logout">Log out</a>
    </nav>
  </header>

  <div class="layout">

    <!-- history list -->
    <aside class="history">
      <h2>History</h2>
      <% if (lectures.length === 0) { %>
        <small>No notes yet.</small>
      <% } %>
      <% lectures.forEach(function (l) { %>
        <a href="/notes/<%= l._id %>" class="<%= lecture && String(lecture._id) === String(l._id) ? 'active' : '' %>">
          <b><%= l.title %></b>
          <small><%= new Date(l.createdAt).toLocaleDateString() %></small>
        </a>
      <% }); %>
    </aside>

    <!-- selected note -->
    <main>
      <% if (lecture) { %>
        <h1><%= lecture.title %></h1>
        <p class="meta">
          Saved on <%= new Date(lecture.createdAt).toLocaleDateString() %>
          &nbsp;&middot;&nbsp; <a href="<%= lecture.videoUrl %>" target="_blank" rel="noopener">Watch the video</a>
        </p>
        <article class="notes"><%- lecture.notes %></article>
      <% } else { %>
        <div class="empty">
          <p><%= lectures.length ? 'Pick a note from your history.' : 'You have no notes yet.' %></p>
          <a href="/">Generate notes</a>
        </div>
      <% } %>
    </main>

  </div>

</body>
</html>