<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Video Summary</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: #fafafa;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }

       .container {
    width: 100%;
    max-width: 820px;  /* was 640px */
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    padding: 36px;
}

        h1 {
            color: #1a1a1a;
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 6px;
            text-align: center;
        }

        .subtitle {
            text-align: center;
            color: #888;
            font-size: 13px;
            margin-bottom: 28px;
        }

        .summary-box {
            background: #fafafa;
            border: 1px solid #eee;
            padding: 24px;
            border-radius: 10px;
            line-height: 1.8;
            color: #333;
            font-size: 15px;
            overflow-wrap: break-word;
        }

        .center {
            text-align: center;
            margin-top: 24px;
        }

        .btn {
            display: inline-block;
            text-decoration: none;
            background: #2d2d2d;
            color: white;
            padding: 11px 22px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.2s;
        }

        .btn:hover {
            background: #1a1a1a;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Your Notes Are Ready</h1>
    <p class="subtitle">AI-generated summary from your video</p>

    <div class="summary-box">
        <%- summary %>
    </div>

    <div class="center">
        <a href="/youtube" class="btn">← Analyze Another Video</a>
    </div>

</div>

</body>
</html>