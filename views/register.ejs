<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create account | YT Notes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #1c2557;
      --ink-2: #2b3778;
      --paper: #f4f6fb;
      --text: #1a1f36;
      --muted: #5d6480;
      --line: #d3d9ea;
      --mark: #ffe45c;
      --danger: #c0352b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
      color: var(--text);
      background: var(--paper);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    .shell { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); min-height: 100vh; }

    /* left: what the app does */
    .story {
      background: var(--ink);
      color: #dfe4ff;
      padding: 48px clamp(28px, 5vw, 72px);
      display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
    }
    .brand {
      display: flex; align-items: center; gap: 10px;
      font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
      font-weight: 700; font-size: 1.3rem; color: #fff; text-decoration: none;
    }
    .brand-icon {
      width: 34px; height: 34px; border-radius: 9px; background: var(--mark);
      display: grid; place-items: center;
    }
    .story h1 {
      font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
      font-weight: 700; color: #fff; letter-spacing: -0.02em; line-height: 1.06;
      font-size: clamp(2.1rem, 3.6vw, 3.3rem); max-width: 15ch; margin-bottom: 16px;
    }
    .story .lede { font-size: 1.05rem; line-height: 1.55; max-width: 38ch; color: #b9c1ec; }

    .sheet {
      background: #fff; color: var(--text); border-radius: 14px;
      padding: 24px 26px; max-width: 460px; transform: rotate(-1deg);
      box-shadow: 0 24px 48px -16px rgba(0, 0, 10, .55);
    }
    .sheet-title {
      font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
      font-weight: 700; font-size: 1.15rem;
    }
    .sheet-src { font-size: .85rem; color: var(--muted); margin: 2px 0 16px; }
    .sheet ul { list-style: none; display: grid; gap: 12px; }
    .sheet li { display: grid; grid-template-columns: 48px 1fr; gap: 10px; font-size: .98rem; line-height: 1.45; }
    .sheet .t { font-variant-numeric: tabular-nums; color: var(--ink-2); font-weight: 600; }
    mark {
      color: inherit; background: linear-gradient(transparent 52%, var(--mark) 52%, var(--mark) 92%, transparent 92%);
      padding: 0 2px;
    }

    /* right: the form */
    .panel { display: grid; place-items: center; padding: 40px 24px; }
    .form-wrap { width: 100%; max-width: 400px; }
    .form-wrap h2 {
      font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
      font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px;
    }
    .sub { color: var(--muted); margin-bottom: 28px; line-height: 1.5; }
    .alert {
      border-left: 4px solid var(--danger); background: #fdecea; color: #8f231b;
      padding: 12px 14px; border-radius: 6px; font-size: .95rem; margin-bottom: 20px;
    }
    .field { margin-bottom: 18px; }
    label { display: block; font-weight: 600; font-size: .92rem; margin-bottom: 6px; }
    .input-wrap { position: relative; }
    input {
      width: 100%; height: 48px; padding: 0 14px; font: inherit; color: var(--text);
      background: #fff; border: 1.5px solid var(--line); border-radius: 10px;
      transition: border-color .15s, box-shadow .15s;
    }
    input::placeholder { color: #9aa1bb; }
    input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(28, 37, 87, .16); }
    .has-toggle input { padding-right: 68px; }
    .toggle {
      position: absolute; right: 6px; top: 6px; height: 36px; padding: 0 10px;
      background: none; border: none; border-radius: 8px; cursor: pointer;
      font: inherit; font-size: .88rem; font-weight: 600; color: var(--ink-2);
    }
    .toggle:hover { background: #eceffa; }
    .toggle:focus-visible, .btn:focus-visible, .alt a:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
    .hint { font-size: .85rem; color: var(--muted); margin-top: 6px; }
    .btn {
      width: 100%; height: 50px; margin-top: 8px; border: none; border-radius: 10px; cursor: pointer;
      background: var(--ink); color: #fff; font: inherit; font-weight: 600; font-size: 1rem;
      transition: background .15s;
    }
    .btn:hover { background: var(--ink-2); }
    .alt { text-align: center; margin-top: 24px; color: var(--muted); font-size: .95rem; }
    .alt a { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 860px) {
      .shell { grid-template-columns: 1fr; }
      .story { padding: 24px; gap: 20px; }
      .story h1 { font-size: 1.9rem; margin-bottom: 0; }
      .story .lede, .sheet { display: none; }
      .panel { align-items: start; padding-top: 32px; }
    }
  </style>
</head>
<body>
  <div class="shell">

    <aside class="story">
      <a class="brand" href="/">
        <span class="brand-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="#1c2557"/></svg>
        </span>
        YT Notes
      </a>

      <div>
        <h1>Paste a lecture. Get notes you can study from.</h1>
        <p class="lede">Drop in a YouTube link and get the key points, with timestamps, in a clean set of notes.</p>
      </div>

      <div class="sheet" aria-hidden="true">
        <p class="sheet-title">How neural networks learn</p>
        <p class="sheet-src">youtube.com/watch &middot; 18:42</p>
        <ul>
          <li><span class="t">02:10</span><span>A network learns by <mark>minimizing a loss function</mark>.</span></li>
          <li><span class="t">06:35</span><span>The <mark>learning rate</mark> sets how big each step is.</span></li>
          <li><span class="t">12:48</span><span>Too high a rate <mark>overshoots the minimum</mark>.</span></li>
        </ul>
      </div>
    </aside>

    <main class="panel">
      <div class="form-wrap">
        <h2>Create your account</h2>
        <p class="sub">It takes a few seconds. Then paste your first lecture link.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert" role="alert"><%= error %></div>
        <% } %>

        <form method="POST" action="/register">
          <div class="field">
            <label for="name">Name</label>
            <div class="input-wrap"><input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" required ></div>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <div class="input-wrap"><input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required ></div>
          </div>
          <div class="field">
            <label for="password">Password</label>
            <div class="input-wrap has-toggle">
              <input id="password" name="password" type="password" placeholder="Create a password" autocomplete="new-password" required minlength="6">
              <button type="button" class="toggle" data-target="password" aria-label="Show password">Show</button>
            </div>
            <p class="hint">Use at least 6 characters.</p>
          </div>
          <button type="submit" class="btn">Create account</button>
        </form>

        <p class="alt">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </main>

  </div>

  <script>
    document.querySelectorAll('.toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.textContent = show ? 'Hide' : 'Show';
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      });
    });
  </script>
</body>
</html>
